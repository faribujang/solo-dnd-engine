# Copy to `.env`. Every npm script loads it automatically.
#
# With NO keys set the game runs on MockLLM — deterministic, offline, free, and what the
# whole test suite uses. That is the normal way to develop; keys are only needed to hear
# an actual Dungeon Master.
#
# A provider with no key is simply not registered, and the router falls through to the
# next one in config/models.json's fallback_chain.

# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Override only if you are pointed at a proxy or a non-default endpoint.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
