    "approval": [
      {
        "on": "spared_enemy",
        "dims": {
          "affinity": 8,
          "respect": 5
        },
        "line": "\"Good. That one didn't need to die.\""
      },
      {
        "on": "killed_surrendered",
        "dims": {
          "affinity": -12,
          "trust": -6
        },
        "line": "\"It had stopped. You saw that it had stopped.\""
      },
      {
        "on": "protected_ally",
        "dims": {
          "affinity": 7,
          "trust": 5
        },
        "line": "\"I saw that. Thank you.\""
      },
      {
        "on": "let_ally_fall",
        "dims": {
          "affinity": -10,
          "trust": -8
        },
        "line": "\"We do not leave people down. Not ever.\""
      },
      {
        "on": "gave_charity",
        "dims": {
          "affinity": 6
        },
        "line": "\"That will matter to them longer than it costs you.\""
      },
      {
        "on": "helped_stranger",
        "dims": {
          "affinity": 6,
          "respect": 3
        },
        "line": "\"You didn't have to. That's rather the point.\""
      },
      {
        "on": "intimidated",
        "dims": {
          "affinity": -5
        },
        "line": "\"There were other ways to ask.\""
      },
      {
        "on": "persuaded",
        "dims": {
          "affinity": 5,
          "respect": 4
        },
        "line": "\"See? Nobody had to bleed for that.\""
      },
      {
        "on": "lied",
        "dims": {
          "trust": -5
        },
        "line": "She says nothing, which is worse."
      },
      {
        "on": "stole",
        "dims": {
          "affinity": -6,
          "trust": -6
        },
        "line": "\"Put it back. I'll wait.\""
      },
      {
        "on": "desecrated",
        "dims": {
          "affinity": -14,
          "trust": -8
        },
        "line": "\"Whatever you think is down there — that was somebody's grave.\""
      },
      {
        "on": "rested_in_danger",
        "dims": {
          "respect": -3
        },
        "line": "\"Here? Really here?\""
      },
      {
        "on": "pressed_on_hurt",
        "dims": {
          "affinity": -4,
          "respect": 2
        },
        "line": "\"You're bleeding. I can fix that, if you'd stop.\""
      },
      {
        "on": "fled_combat",
        "dims": {
          "respect": -4
        },
        "line": "\"We can come back. I'd rather come back.\""
      },
      {
        "on": "investigated",
        "dims": {
          "respect": 3
        },
        "line": "\"You look before you leap. Rare.\""
      }
    ]
  }
