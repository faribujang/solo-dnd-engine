    "on_first_talk": [],
    "alive": true,
    "flags": {
      "talked_to": false,
      "social_tags": [
        "criminal"
      ]
    },
    "pronouns": "he/him",
    "alignment": "lawful_neutral",
    "xp": 0,
    "recruitable": true,
    "recruit_condition": "Show him the Ashen Hand will not protect his sister, and give him somewhere else to stand.",
    "flee_behavior": "run",
    "approval": [
      {
        "on": "spared_enemy",
        "dims": {
          "respect": -6
        },
        "line": "\"That was mercy. Mercy gets people killed later.\""
      },
      {
        "on": "killed_surrendered",
        "dims": {
          "respect": 4,
          "fear": 4
        },
        "line": "He doesn't look away. That is its own kind of answer."
      },
      {
        "on": "intimidated",
        "dims": {
          "respect": 6
        },
        "line": "\"That's how you get answers out of people like us.\""
      },
      {
        "on": "persuaded",
        "dims": {
          "respect": -2
        },
        "line": "\"They'll say what you want. Doesn't make it true.\""
      },
      {
        "on": "gave_charity",
        "dims": {
          "affinity": -3
        },
        "line": "\"That coin was going to feed you.\""
      },
      {
        "on": "protected_ally",
        "dims": {
          "affinity": 8,
          "trust": 6
        },
        "line": "\"...you didn't have to do that.\""
      },
      {
        "on": "fled_combat",
        "dims": {
          "respect": -8
        },
        "line": "\"Right. Of course.\""
      },
      {
        "on": "pressed_on_hurt",
        "dims": {
          "respect": 6
        },
        "line": "\"Good. Don't stop.\""
      },
      {
        "on": "stole",
        "dims": {
          "affinity": 3
        },
        "line": "He pretends he didn't see, which is a kindness of a sort."
      },
      {
        "on": "desecrated",
        "dims": {
          "fear": 5
        },
        "line": "\"Whatever you woke up down here is on you.\""
      }
    ]
  },
