      "armor": null,
      "trinket": null
    },
    "personality": {
      "traits": [
        "cannot sit with his back to a door and has never noticed",
        "gives things away and then wants them back"
      ],
      "ideal": "Nobody gets left on the bank.",
      "bond": "You. Loudly, and to anyone who asks.",
      "flaw": "Says the true thing at the worst possible moment.",
      "voice": "fast, warm, jokes a half-second before the room is ready"
    },
    "goals": [
      {
        "text": "Get out of Wickmoor before the levy makes it impossible",
        "priority": 1,
        "quest_id": null
      }
    ],
    "schedule": [],
    "known_fact_ids": [],
    "ai_policy": null,
    "approval": [
      {
        "on": "spared_enemy",
        "dims": {
          "affinity": 8,
          "respect": 4
        },
        "line": "\"Right. Good. I didn't want to watch that.\""
      },
      {
        "on": "killed_surrendered",
        "dims": {
          "affinity": -14,
          "trust": -8
        },
        "line": "\"They'd stopped. You know they'd stopped.\""
      },
      {
        "on": "protected_ally",
        "dims": {
          "affinity": 10,
          "trust": 8
        },
        "line": "\"I saw that. I'm not going to forget I saw that.\""
      },
      {
        "on": "let_ally_fall",
        "dims": {
          "affinity": -12,
          "trust": -10
        },
        "line": "\"They were RIGHT THERE.\""
      },
      {
        "on": "took_reward",
        "dims": {
          "affinity": -5
        },
        "line": "\"That's their money. That's literally their money.\""
      },
      {
        "on": "helped_stranger",
        "dims": {
          "affinity": 6
        },
        "line": "\"Cost us nothing. Worth doing.\""
      },
      {
        "on": "gave_charity",
        "dims": {
          "affinity": 7,
          "respect": 3
        },
        "line": "\"You didn't have to do that. I noticed you did it anyway.\""
      },
      {
        "on": "lied",
        "dims": {
          "trust": -8,
          "affinity": -4
        },
        "line": "\"You're doing the voice. You do a voice when you're lying.\""
      },
      {
        "on": "stole",
        "dims": {
          "affinity": -4,
          "trust": -3
        },
        "line": "\"Put it back. Put it back now.\""
      },
      {
        "on": "kept_promise",
        "dims": {
          "trust": 8,
          "respect": 5
        },
        "line": "\"You said you would. You did.\""
      },
      {
        "on": "broke_promise",
        "dims": {
          "trust": -12,
          "affinity": -6
        },
        "line": "\"To me? You did that to me?\""
      },
      {
        "on": "desecrated",
        "dims": {
          "affinity": -10,
          "respect": -8
        },
        "line": "\"They're somebody's. Every one of them is somebody's.\""
      },
      {
        "on": "fled_combat",
        "dims": {
          "affinity": 2
        },
        "line": "\"No — good. Good call. Running is a call.\""
      },
      {
        "on": "investigated",
        "dims": {
          "respect": 6,
          "trust": 4
        },
        "line": "\"See, this is why it's you and not Tam.\""
      },
      {
        "on": "intimidated",
        "dims": {
          "affinity": -3,
          "fear": 3
        },
        "line": "\"...that worked. I didn't like it, but it worked.\""
      }
    ],
    "flee_behavior": "run",
